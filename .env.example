# ==============================================================
# TEMPLATE CONFIGURATION - RENAME THIS FILE TO .env
# ==============================================================

# Server Settings
HOST=0.0.0.0
PORT=8001

# Browser Settings
HEADLESS_MODE=False

# Scraping Delays (in seconds)
REQUEST_DELAY_MIN=0.5
REQUEST_DELAY_MAX=1.5
PAGE_TIMEOUT=20
MAX_RETRIES=3

# Output Paths
OUTPUT_DIR=./exports
EXCEL_FILENAME=FINAL_FULL_DATA.xlsx
CSV_FILENAME=FINAL_FULL_DATA.csv

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/scraper.log

# Custom User Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Proxy (Optional)
# PROXY_URL=http://user:password@proxy_host:port

